<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sin internet a propósito: todo se queda en el móvil. tools:node="remove" quita el
      permiso aunque una librería lo pida al fusionar manifiestos, tanto con uses-permission
      como con uses-permission-sdk-23 (revisa la pestaña "Merged Manifest" cada vez que
      añadas una dependencia).
      ACCESS_NETWORK_STATE y FOREGROUND_SERVICE los añade WorkManager y no se usan. Si algún
      día se usan restricciones de red o setForeground en WorkManager, hay que volver a
      añadirlos (quitando estas líneas). WAKE_LOCK y RECEIVE_BOOT_COMPLETED se mantienen:
      WorkManager los necesita.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission-sdk-23
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission-sdk-23
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Tiempo por app y desbloqueos. Se concede a mano en Ajustes > Acceso a datos de uso. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Para mostrar el nombre e icono de las apps del panel: las que tienen icono en el
      lanzador y algunos componentes del sistema que suman tiempo sin tenerlo.
      No usar QUERY_ALL_PACKAGES (Google Play lo restringe).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.permissioncontroller" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.android.intentresolver" />
    </queries>

    <!--
      Copias: nada sale del móvil. allowBackup="false" lo desactiva todo hasta Android 11;
      desde Android 12 algunos fabricantes lo ignoran en la transferencia entre móviles, y
      data_extraction_rules lo excluye todo de forma explícita (nube y transferencia).
    -->
    <application
        android:name=".FreeDoomApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeDoom"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".accessibility.ShortVideoAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
