<?xml version="1.0" encoding="utf-8"?>
<!--
  La lista real de apps vigiladas está en ShortVideoConfig.kt: el servicio la
  aplica al conectarse. Aquí se repite Instagram para que el filtro esté activo
  desde el primer evento.

  android:isAccessibilityTool NUNCA debe ser true: está reservado a herramientas para
  personas con discapacidad (lectores de pantalla, etc.). FreeDoom no lo es, y declararlo
  incumpliría la política de Google Play.
  No cambiar android:notificationTimeout: con más de 0 Android agrupa los scrolls y se
  perderían deslizamientos rápidos.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="0"
    android:packageNames="com.instagram.android" />
